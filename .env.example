# Kwegatta Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to version control or expose API keys in client-side code.

# Server-Side API Key for Gemma 4 open-weight model (gemma-4-31b-it)
# The key is strictly read by server.ts and never sent to browser code.
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# Local Server Port (default: 3000)
PORT=3000

# Public or deployment URL (e.g., https://kwegatta.org or Cloud Run URL)
APP_URL="http://localhost:3000"
