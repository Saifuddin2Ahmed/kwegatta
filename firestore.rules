rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profiles collection:
    // A member can write only documents they own (matched by document ID or account_uid)
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.auth.uid == profileId ||
        request.resource.data.account_uid == request.auth.uid ||
        request.resource.data.id == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == profileId ||
        resource.data.account_uid == request.auth.uid ||
        request.resource.data.account_uid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == profileId ||
        resource.data.account_uid == request.auth.uid
      );
    }

    // Follows collection:
    // Only the follower can create or remove their follow records
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.follower_id == request.auth.uid ||
        request.resource.data.follower_account_uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.follower_id == request.auth.uid ||
        resource.data.follower_account_uid == request.auth.uid
      );
    }

    // Matches collection:
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications collection (Recipient only)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.to_id == request.auth.uid ||
        resource.data.to_account_uid == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.to_id == request.auth.uid ||
        resource.data.to_account_uid == request.auth.uid
      );
    }

    // Posts collection:
    // A member can only write posts they own
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.author_id == request.auth.uid ||
        request.resource.data.author_account_uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.author_id == request.auth.uid ||
        resource.data.author_account_uid == request.auth.uid
      );
    }

    // Reports collection:
    // Authenticated members can submit safety reports; only admin can read
    match /reports/{reportId} {
      allow read: if false; // Server-side admin only
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Sessions and Audit Log (server-side only via Admin SDK)
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    match /audit_log/{logId} {
      allow read, write: if false;
    }
  }
}
